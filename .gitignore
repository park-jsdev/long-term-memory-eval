# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Python / env ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# --- Experimental data (fetched / derived; not source of truth in git) ---
# LoCoMo raw release (CC BY-NC 4.0) — use scripts/fetch_locomo.py
data/raw/*
!data/raw/.gitkeep
# Flattened QA / processed tables
data/processed/*
!data/processed/.gitkeep

# --- Run artifacts, local logs ---
# Per-run preds, metrics, plots, memory dumps (never commit these)
experiments/*
!experiments/.gitkeep
# Legacy output root; current packs live under experiments/
results/
logs/*
!logs/.gitkeep
outputs/
*.log
# LLM response-hash cache was removed; keep the name ignored if a leftover appears
experiments/cache/

# Optional local notebooks outputs (keep .ipynb source if intentionally tracked)
.ipynb_checkpoints/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
