# --- Secrets (never commit) ---
.env
.env.*
!.env.example
# Service-account keys / certs, in case one is ever downloaded into the tree
*.pem
*.p12
*-key.json
service-account*.json
gcloud-*.json

# --- Python / env ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# --- Experimental data (fetched / derived; not source of truth in git) ---
# LoCoMo raw release (CC BY-NC 4.0) — use scripts/fetch_locomo.py
data/raw/*
!data/raw/.gitkeep
# Flattened QA / processed tables
data/processed/*
!data/processed/.gitkeep

# --- Run artifacts, local logs ---
# Per-run preds, metrics, plots, memory dumps.
# The reader-analysis v2 pack is the published reference run.
experiments/*
!experiments/.gitkeep
!experiments/locomo-openai-mini-codex-readers-analysis-v2/
# Legacy output root; current packs live under experiments/
results/
logs/*
!logs/.gitkeep
outputs/
*.log
# LLM response-hash cache was removed; keep the name ignored if a leftover appears
experiments/cache/

# --- Third-party literature (copyright: cite, do not redistribute) ---
papers/

# --- Local development history (not needed to reproduce the setup) ---
# Per-change snapshots of AGENTS/HUMANS; useful locally, noise in a shared repo
docs/agent/traces/
# Operator notes stay local. The published agent note is AGENTS.md.
# Cloud steps live in docs/gcp.md and infra/gcp/README.md.
docs/agent/*.md
!docs/agent/AGENTS.md
docs/reflections/
# Local writeups. The published path is README, REPRODUCE, architecture, and runbooks.
docs/reports/

# --- Notebooks ---
# Executed notebooks carry local paths, cloud ids, and outputs.
# The reader-analysis wrapper is the published analysis notebook.
notebooks/*
*.ipynb
.ipynb_checkpoints/
!notebooks/17_openai_mini_codex_readers_analysis.ipynb

# Matrix YAML notes. The expander in src/experiment_runner is the contract.
docs/schemas/experiment_matrix.md

# --- IDE / OS ---
.idea/
.vscode/
.cursor/
*.swp
*~
.DS_Store
Thumbs.db
