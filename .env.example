# Copy to .env in the repo root and fill in values.
#   copy .env.example .env
# .env is gitignored — never commit real keys.
#
# Reader / Mem0 writer / autorater:
OPENAI_API_KEY=sk-your-openai-key-here
#
# Teacher plumbing (cheap models for sanity; swap to strong models later):
#   OpenAI   → gpt-4o-mini
#   Anthropic → claude-haiku-4-5
#   DeepSeek  → deepseek-v4-flash
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# Required for identity-linked (personal/service) keys that are not scoped
# to one workspace. Claude Console → Settings → Workspaces → copy wrkspc_...
# Skip this if you created a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

